from pathlib import Path
import json
import requests
import pandas as pd
from datetime import datetime

# ==========================================================
# Paths
# ==========================================================

ROOT = Path(__file__).resolve().parent

CONFIG = ROOT / "Config" / "config.json"
TRACKER = ROOT / "Database" / "housing_tracker.csv"
LOG = ROOT / "Database" / "applications_log.csv"
STATUS = ROOT / "Database" / "listing_status.json"

# ==========================================================
# Load configuration
# ==========================================================

with open(CONFIG, "r", encoding="utf-8") as f:
    cfg = json.load(f)

TOKEN = cfg["telegram"]["bot_token"]

# ==========================================================
# Load tracker
# ==========================================================

tracker = pd.read_csv(TRACKER)

# Ensure required columns exist

for col in ["status", "saved_at"]:
    if col not in tracker.columns:
        tracker[col] = ""

# ==========================================================
# Load application log
# ==========================================================

if LOG.exists():
    log = pd.read_csv(LOG)
else:
    log = pd.DataFrame(columns=[
        "time",
        "url",
        "title",
        "price",
        "decision",
        "status"
    ])

# ==========================================================
# Load listing status database
# ==========================================================

if STATUS.exists():
    with open(STATUS, "r", encoding="utf-8") as f:
        listing_status = json.load(f)
else:
    listing_status = {}

# ==========================================================
# Telegram Updates
# ==========================================================

updates = requests.get(
    f"https://api.telegram.org/bot{TOKEN}/getUpdates"
).json()

processed = 0

# ==========================================================
# Process callbacks
# ==========================================================

for item in updates.get("result", []):

    callback = item.get("callback_query")

    if callback is None:
        continue

    try:

        action, index = callback["data"].split("|")
        index = int(index)

    except Exception:
        continue

    if index >= len(tracker):
        continue

    prop = tracker.loc[index]

    chat = callback["message"]["chat"]["id"]
    msg = callback["message"]["message_id"]

    now = datetime.now().strftime("%Y-%m-%d %H:%M")
    url = prop["url"]

    # ------------------------------------------------------
    # AI Message
    # ------------------------------------------------------

    if action == "message":

        ai = f"""Hello,

My name is Grifton Muchovu.

I am relocating to Rotterdam to work as a researcher at Erasmus MC on a long-term employment contract, and I am very interested in the property at {prop['title']} in {prop['city']}.

A little about me:

• Researcher at Erasmus MC
• Stable employment contract
• Reliable monthly income
• Non-smoker
• Quiet, clean and respectful tenant
• Looking for a long-term home
• Municipal registration required
• References available immediately

I would be happy to arrange a viewing.

Kind regards,

Grifton Muchovu"""

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/sendMessage",
            json={
                "chat_id": chat,
                "text": ai
            }
        )

    # ------------------------------------------------------
    # Applied
    # ------------------------------------------------------

    elif action == "applied":

        tracker.loc[index, "status"] = "Applied"

        listing_status[url] = {
            "status": "Applied",
            "updated": now
        }

        log.loc[len(log)] = [
            now,
            url,
            prop["title"],
            prop["price"],
            "Applied",
            "Completed"
        ]

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/editMessageReplyMarkup",
            json={
                "chat_id": chat,
                "message_id": msg,
                "reply_markup": {
                    "inline_keyboard": [
                        [
                            {
                                "text": "🟢 Applied",
                                "callback_data": "done"
                            }
                        ]
                    ]
                }
            }
        )

    # ------------------------------------------------------
    # Rejected
    # ------------------------------------------------------

    elif action == "reject":

        tracker.loc[index, "status"] = "Rejected"

        listing_status[url] = {
            "status": "Rejected",
            "updated": now
        }

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/editMessageReplyMarkup",
            json={
                "chat_id": chat,
                "message_id": msg,
                "reply_markup": {
                    "inline_keyboard": [
                        [
                            {
                                "text": "❌ Rejected",
                                "callback_data": "done"
                            }
                        ]
                    ]
                }
            }
        )

    # ------------------------------------------------------
    # Save For Later
    # ------------------------------------------------------

    elif action == "save":

        tracker.loc[index, "status"] = "Saved"
        tracker.loc[index, "saved_at"] = now

        listing_status[url] = {
            "status": "Saved",
            "saved_at": now
        }

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/editMessageReplyMarkup",
            json={
                "chat_id": chat,
                "message_id": msg,
                "reply_markup": {
                    "inline_keyboard": [
                        [
                            {
                                "text": "💾 Saved for Later",
                                "callback_data": "done"
                            }
                        ]
                    ]
                }
            }
        )

    processed += 1

# ==========================================================
# Save files
# ==========================================================

tracker.to_csv(TRACKER, index=False)
log.to_csv(LOG, index=False)

with open(STATUS, "w", encoding="utf-8") as f:
    json.dump(listing_status, f, indent=2)

# ==========================================================
# Clear processed updates
# ==========================================================

if updates.get("result"):

    last = max(u["update_id"] for u in updates["result"])

    requests.get(
        f"https://api.telegram.org/bot{TOKEN}/getUpdates",
        params={"offset": last + 1}
    )

print(f"Processed {processed} callbacks.")
