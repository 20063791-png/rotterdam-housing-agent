from pathlib import Path
import json
import requests
import pandas as pd
from datetime import datetime

ROOT=Path(__file__).resolve().parent

CONFIG=ROOT/"Config/config.json"
TRACKER=ROOT/"Database/housing_tracker.csv"
LOG=ROOT/"Database/applications_log.csv"

with open(CONFIG,"r",encoding="utf-8") as f:
    cfg=json.load(f)

TOKEN=cfg["telegram"]["bot_token"]

tracker=pd.read_csv(TRACKER)

if LOG.exists():
    log=pd.read_csv(LOG)
else:
    log=pd.DataFrame(columns=[
        "time","url","title","price","decision","status"
    ])

updates=requests.get(
    f"https://api.telegram.org/bot{TOKEN}/getUpdates"
).json()

processed=0

for item in updates.get("result",[]):

    callback=item.get("callback_query")

    if callback is None:
        continue

    action,index=callback["data"].split("|")
    index=int(index)

    prop=tracker.loc[index]

    chat=callback["message"]["chat"]["id"]
    msg=callback["message"]["message_id"]

    if action=="message":

        ai=f"""Hi,

I am interested in {prop['title']} in {prop['city']}.

I am relocating to the Netherlands for work as a researcher and I am looking for a long-term rental.

I would appreciate the opportunity to arrange a viewing.

Kind regards,

Grifton Muchovu"""

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/sendMessage",
            json={
                "chat_id":chat,
                "text":ai
            }
        )

    elif action=="applied":

        tracker.loc[index,"status"]="Applied"

        log.loc[len(log)]=[
            datetime.now().strftime("%Y-%m-%d %H:%M"),
            prop["url"],
            prop["title"],
            prop["price"],
            "Applied",
            "Completed"
        ]

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/editMessageText",
            json={
                "chat_id":chat,
                "message_id":msg,
                "text":"🟢 Applied — removed from future alerts."
            }
        )

    elif action=="reject":

        tracker.loc[index,"status"]="Rejected"

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/editMessageText",
            json={
                "chat_id":chat,
                "message_id":msg,
                "text":"❌ Rejected — removed from future alerts."
            }
        )

    processed+=1

tracker.to_csv(TRACKER,index=False)
log.to_csv(LOG,index=False)

if updates.get("result"):
    last=max(u["update_id"] for u in updates["result"])
    requests.get(
        f"https://api.telegram.org/bot{TOKEN}/getUpdates",
        params={"offset":last+1}
    )

print(f"Processed {processed} callbacks.")
