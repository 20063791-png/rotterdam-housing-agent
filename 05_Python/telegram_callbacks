from pathlib import Path
import json
import requests
import pandas as pd
import os
from datetime import datetime

ROOT = Path(__file__).resolve().parent

CONFIG = ROOT / "Config/config.json"
TRACKER = ROOT / "Database/housing_tracker.csv"
LOG = ROOT / "Database/applications_log.csv"
STATUS = ROOT / "Database/listing_status.json"

with open(CONFIG, "r", encoding="utf-8") as f:
    cfg = json.load(f)

TOKEN = os.getenv("BOT_TOKEN") or cfg["telegram"]["bot_token"]

tracker = pd.read_csv(TRACKER)

if LOG.exists():
    log = pd.read_csv(LOG)
else:
    log = pd.DataFrame(columns=[
        "time", "url", "title", "price", "decision", "status"
    ])

if STATUS.exists():
    with open(STATUS, "r", encoding="utf-8") as f:
        listing_status = json.load(f)
else:
    listing_status = {}

# ==========================================================
# Read Telegram updates
# ==========================================================

updates = requests.get(
    f"https://api.telegram.org/bot{TOKEN}/getUpdates",
    timeout=20
).json()

processed = 0

for item in updates.get("result", []):

    callback = item.get("callback_query")

    if callback is None:
        continue

    data = callback["data"]

    if "_" not in data:
        continue

    action, index = data.split("_", 1)

    try:
        index = int(index)
    except:
        continue

    if index >= len(tracker):
        continue

    prop = tracker.loc[index]

    chat = callback["message"]["chat"]["id"]
    msg = callback["message"]["message_id"]

    url = prop["url"]

    # ======================================================
    # APPLIED
    # ======================================================

    if action == "applied":

        tracker.loc[index, "status"] = "Applied"

        listing_status[url] = {
            "status": "Applied",
            "time": datetime.now().isoformat()
        }

        log.loc[len(log)] = [
            datetime.now().strftime("%Y-%m-%d %H:%M"),
            url,
            prop["title"],
            prop["price"],
            "Applied",
            "Completed"
        ]

        # Instant Telegram popup
        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/answerCallbackQuery",
            json={
                "callback_query_id": callback["id"],
                "text": "✅ Applied saved"
            },
            timeout=20
        )

        # Replace buttons with completed state
        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/editMessageReplyMarkup",
            json={
                "chat_id": chat,
                "message_id": msg,
                "reply_markup": {
                    "inline_keyboard": [
                        [
                            {
                                "text": "✅ Applied",
                                "callback_data": "done"
                            }
                        ]
                    ]
                }
            },
            timeout=20
        )

        # Confirmation message
        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/sendMessage",
            json={
                "chat_id": chat,
                "text": f"🟢 Application recorded for:\n{prop['title']}"
            },
            timeout=20
        )

    # ======================================================
    # SAVE FOR LATER
    # ======================================================

    elif action == "save":

        tracker.loc[index, "status"] = "Saved"

        listing_status[url] = {
            "status": "Saved",
            "time": datetime.now().isoformat()
        }

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/answerCallbackQuery",
            json={
                "callback_query_id": callback["id"],
                "text": "📌 Saved for later"
            },
            timeout=20
        )

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/editMessageReplyMarkup",
            json={
                "chat_id": chat,
                "message_id": msg,
                "reply_markup": {
                    "inline_keyboard": [
                        [
                            {
                                "text": "📌 Saved",
                                "callback_data": "done"
                            }
                        ]
                    ]
                }
            },
            timeout=20
        )

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/sendMessage",
            json={
                "chat_id": chat,
                "text": (
                    f"📌 Saved for later:\n{prop['title']}\n\n"
                    "You'll receive daily reminders at 21:00 "
                    "(next feature)."
                )
            },
            timeout=20
        )

    # ======================================================
    # REJECT
    # ======================================================

    elif action == "reject":

        tracker.loc[index, "status"] = "Rejected"

        listing_status[url] = {
            "status": "Rejected",
            "time": datetime.now().isoformat()
        }

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/answerCallbackQuery",
            json={
                "callback_query_id": callback["id"],
                "text": "❌ Rejected"
            },
            timeout=20
        )

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/editMessageReplyMarkup",
            json={
                "chat_id": chat,
                "message_id": msg,
                "reply_markup": {
                    "inline_keyboard": [
                        [
                            {
                                "text": "❌ Rejected",
                                "callback_data": "done"
                            }
                        ]
                    ]
                }
            },
            timeout=20
        )

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/sendMessage",
            json={
                "chat_id": chat,
                "text": f"❌ Rejected:\n{prop['title']}"
            },
            timeout=20
        )

    processed += 1

# ==========================================================
# Save databases
# ==========================================================

tracker.to_csv(TRACKER, index=False)
log.to_csv(LOG, index=False)

with open(STATUS, "w", encoding="utf-8") as f:
    json.dump(listing_status, f, indent=2)

# ==========================================================
# Clear processed Telegram updates
# ==========================================================

if updates.get("result"):
    last = max(u["update_id"] for u in updates["result"])
    requests.get(
        f"https://api.telegram.org/bot{TOKEN}/getUpdates",
        params={"offset": last + 1},
        timeout=20
    )

print(f"Processed {processed} callbacks.")
