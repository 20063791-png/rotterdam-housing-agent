import json
import requests
from pathlib import Path

ROOT = Path(__file__).resolve().parent

CONFIG = ROOT/"Config"/"config.json"
TRACKER = ROOT/"Database"/"housing_tracker.csv"

with open(CONFIG,"r",encoding="utf-8") as f:
    config=json.load(f)

TOKEN=config["telegram"]["bot_token"]

updates=requests.get(
    f"https://api.telegram.org/bot{TOKEN}/getUpdates"
).json()

if TRACKER.exists():

    import pandas as pd

    tracker=pd.read_csv(TRACKER)

    for item in updates.get("result",[]):

        callback=item.get("callback_query")

        if callback is None:
            continue

        action,index=callback["data"].split("|")

        index=int(index)

        if index>=len(tracker):
            continue

        chat=callback["message"]["chat"]["id"]
        msg=callback["message"]["message_id"]

        if action=="applied":

            tracker.loc[index,"Status"]="Applied"

            text="✅ Marked as Applied"

        elif action=="reject":

            tracker.loc[index,"Status"]="Rejected"

            text="❌ Property Rejected"

        elif action=="message":

            prop=tracker.loc[index]

            text=(
                f"Hello,\n\n"
                f"I'm interested in {prop['Title']}.\n\n"
                f"I would appreciate arranging a viewing.\n\n"
                f"Kind regards,\n"
                f"Grifton Muchovu"
            )

            requests.post(
                f"https://api.telegram.org/bot{TOKEN}/sendMessage",
                json={
                    "chat_id":chat,
                    "text":text
                }
            )

            continue

        requests.post(
            f"https://api.telegram.org/bot{TOKEN}/editMessageText",
            json={
                "chat_id":chat,
                "message_id":msg,
                "text":text
            }
        )

    tracker.to_csv(TRACKER,index=False)

if updates.get("result"):

    last=max(x["update_id"] for x in updates["result"])

    requests.get(
        f"https://api.telegram.org/bot{TOKEN}/getUpdates",
        params={"offset":last+1}
    )
